# ── Base de datos ─────────────────────────────────────────────
# ADMIN: migraciones, seed y módulo de plataforma (super admin). En Aiven: avnadmin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minimarket_dev"
# RUNTIME: rol SIN BYPASSRLS para todo el tráfico tenant (lo crea la migración RLS).
APP_DATABASE_URL="postgresql://app_runtime:app_runtime_dev@localhost:5432/minimarket_dev"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET="cambiar-por-secreto-largo-aleatorio"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ── Servidor ──────────────────────────────────────────────────
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ── Seed ──────────────────────────────────────────────────────
SEED_SUPERADMIN_EMAIL="superadmin@minimarket.local"
SEED_SUPERADMIN_PASSWORD="SuperAdmin!2026"
SEED_DEMO_PASSWORD="Demo!2026"
