// Esquema Prisma — Fase 0: plataforma + identidad.
// El diseño completo (todas las fases) vive en docs/schema.sql; este archivo
// crece por fases. Dinero: BigInt en centavos de GTQ. Ver CLAUDE.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // URL de ADMIN (migraciones/seed/plataforma). El runtime tenant usa
  // APP_DATABASE_URL (rol sin BYPASSRLS) — ver src/lib/prisma.ts.
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

// ─────────────────────────── Plataforma ───────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TaxRegime {
  GENERAL
  PEQUENO_CONTRIBUYENTE
  NINGUNO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Plan {
  id           String   @id @db.Uuid
  code         String   @unique
  name         String
  maxStores    Int      @map("max_stores")
  maxUsers     Int      @map("max_users")
  monthlyPrice BigInt   @map("monthly_price")
  features     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id              String       @id @db.Uuid
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  suspendedReason String?      @map("suspended_reason")
  contactName     String?      @map("contact_name")
  contactEmail    String?      @map("contact_email")
  contactPhone    String?      @map("contact_phone")
  taxId           String?      @map("tax_id")
  taxRegime       TaxRegime    @default(NINGUNO) @map("tax_regime")
  settings        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions Subscription[]
  users         User[]
  stores        Store[]

  @@map("tenants")
}

model Subscription {
  id          String             @id @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(ACTIVE)
  periodStart DateTime           @map("period_start") @db.Date
  periodEnd   DateTime           @map("period_end") @db.Date
  amount      BigInt
  paymentNote String?            @map("payment_note")
  createdBy   String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, periodEnd(sort: Desc)])
  @@map("subscriptions")
}

model PlatformUser {
  id            String    @id @db.Uuid
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz()
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_users")
}

// ─────────────────────────── Identidad (tenant) ───────────────────────────

enum MemberRole {
  OWNER
  STORE_ADMIN
  WORKER
}

model User {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  email              String    @unique // único GLOBAL en v1 (D-018)
  name               String
  phone              String?
  passwordHash       String    @map("password_hash")
  supervisorPinHash  String?   @map("supervisor_pin_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships   StoreMember[]
  recoveryCodes RecoveryCode[]
  totp          UserTotp?

  @@index([tenantId])
  @@map("users")
}

/**
 * Segundo factor del usuario, en tabla APARTE de `users` (D-033).
 * Motivo: el rol de runtime necesita leer `users` constantemente (nombres,
 * membresías, PIN de supervisor), así que restringir por columna convertía
 * cada consulta sin `select` explícito en una bomba de tiempo. Con el secreto
 * en su propia tabla, al runtime simplemente se le niega el acceso completo y
 * `users` vuelve a ser una tabla normal.
 *
 * `enabledAt` con valor = el usuario ya probó un código válido; hasta entonces
 * el secreto existe pero 2FA no está activo.
 */
model UserTotp {
  userId    String    @id @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  secret    String
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_totp")
}

/**
 * Códigos de recuperación de 2FA (un solo uso, hasheados).
 * Sin esto, un tendero que pierde el teléfono pierde el acceso a su negocio.
 */
model RecoveryCode {
  id             String    @id @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  platformUserId String?   @map("platform_user_id") @db.Uuid
  codeHash       String    @map("code_hash")
  usedAt         DateTime? @map("used_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@map("recovery_codes")
}

model Store {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  address       String?
  phone         String?
  receiptHeader String?  @map("receipt_header")
  receiptFooter String?  @map("receipt_footer")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members StoreMember[]

  @@unique([tenantId, name])
  @@map("stores")
}

model StoreMember {
  id               String     @id @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  role             MemberRole
  extraPermissions Json       @default("[]") @map("extra_permissions")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

// Catálogo RBAC persistido (la evaluación v1 usa las constantes de
// @minimarket/shared; estas tablas documentan y habilitan roles custom futuros)
model Permission {
  id          Int    @id @default(autoincrement())
  code        String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String
  permissionId Int    @map("permission_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id             String    @id @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  platformUserId String?   @map("platform_user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  deviceInfo     String?   @map("device_info")
  ip             String?
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────── Catálogo (Fase 1) ───────────────────────────

model Category {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  products Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Unit {
  id             String  @id @db.Uuid
  tenantId       String? @map("tenant_id") @db.Uuid // NULL = seed global
  code           String
  name           String
  allowsDecimals Boolean @default(false) @map("allows_decimals")

  products Product[]

  @@unique([tenantId, code])
  @@map("units")
}

model Product {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  sku         String
  name        String
  description String?
  categoryId  String?   @map("category_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  basePrice   BigInt    @map("base_price") // centavos, IVA incluido
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  barcodes      ProductBarcode[]
  storeProducts StoreProduct[]
  movements     InventoryMovement[]
  saleItems     SaleItem[]
  supplierLinks ProductSupplier[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

model ProductBarcode {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, barcode])
  @@index([productId])
  @@map("product_barcodes")
}

// Existencia del producto POR TIENDA. stock_qty es materializado: la fuente
// de verdad es inventory_movements (job de consistencia los reconcilia).
model StoreProduct {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  stockQty      Decimal  @default(0) @map("stock_qty") @db.Decimal(12, 3)
  avgCost       BigInt   @default(0) @map("avg_cost") // CPP en centavos
  minStock      Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  priceOverride BigInt?  @map("price_override")
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  alerts  StockAlert[]

  @@unique([storeId, productId])
  @@index([storeId])
  @@map("store_products")
}

// ─────────────────────────── Inventario: kardex ───────────────────────────

enum MovementType {
  INITIAL
  PURCHASE
  PURCHASE_VOID
  SALE
  SALE_VOID
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  INTERNAL_USE
  RETURN_IN
  TRANSFER_IN
  TRANSFER_OUT
}

// Ledger INMUTABLE (trigger anti UPDATE/DELETE en la migración).
model InventoryMovement {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  storeId      String       @map("store_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  type         MovementType
  qty          Decimal      @db.Decimal(12, 3) // con signo: + entra, − sale
  unitCost     BigInt       @default(0) @map("unit_cost")
  balanceAfter Decimal      @map("balance_after") @db.Decimal(12, 3)
  refType      String?      @map("ref_type")
  refId        String?      @map("ref_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([storeId, productId, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("inventory_movements")
}

// ─────────────────────────── Caja (Fase 2) ───────────────────────────

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE_IN
  SALE_VOID_OUT
  WITHDRAWAL
  EXPENSE_OUT
  DEPOSIT_IN
  ADJUSTMENT
}

model CashRegister {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sessions CashSession[]

  @@unique([storeId, name])
  @@map("cash_registers")
}

model CashSession {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  storeId        String            @map("store_id") @db.Uuid
  cashRegisterId String            @map("cash_register_id") @db.Uuid
  status         CashSessionStatus @default(OPEN)
  openedBy       String            @map("opened_by") @db.Uuid
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamptz()
  openingAmount  BigInt            @map("opening_amount")
  closedBy       String?           @map("closed_by") @db.Uuid
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz()
  expectedAmount BigInt?           @map("expected_amount")
  countedAmount  BigInt?           @map("counted_amount")
  countedDetail  Json?             @map("counted_detail") // desglose por denominación
  difference     BigInt? // counted − expected (+ sobrante / − faltante)
  notes          String?

  register  CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  movements CashMovement[]
  sales     Sale[]

  @@index([storeId, openedAt(sort: Desc)])
  @@map("cash_sessions")
}

// Ledger INMUTABLE de caja (trigger anti UPDATE/DELETE en la migración).
model CashMovement {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  storeId       String           @map("store_id") @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  type          CashMovementType
  amount        BigInt // con signo: + entra, − sale (centavos)
  reason        String? // OBLIGATORIO en egresos (validado en dominio)
  evidenceUrl   String?          @map("evidence_url")
  refType       String?          @map("ref_type")
  refId         String?          @map("ref_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  authorizedBy  String?          @map("authorized_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  session CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([cashSessionId, createdAt])
  @@map("cash_movements")
}

// ─────────────────────────── Ventas (Fase 2) ───────────────────────────

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// Correlativo transaccional por tienda y tipo de documento.
model Counter {
  tenantId     String @map("tenant_id") @db.Uuid
  storeId      String @map("store_id") @db.Uuid
  docType      String @map("doc_type")
  currentValue BigInt @default(0) @map("current_value")

  @@id([storeId, docType])
  @@map("counters")
}

// Las ventas NUNCA se borran; la única mutación permitida es la transición a
// VOIDED (trigger en la migración valida columnas).
model Sale {
  id               String     @id @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  cashSessionId    String     @map("cash_session_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  number           BigInt
  status           SaleStatus @default(COMPLETED)
  subtotal         BigInt
  discount         BigInt     @default(0)
  total            BigInt
  taxBreakdown     BigInt     @default(0) @map("tax_breakdown") // IVA informativo incluido
  clientOpId       String     @map("client_op_id") @db.Uuid // idempotencia POS
  voidedAt         DateTime?  @map("voided_at") @db.Timestamptz()
  voidedBy         String?    @map("voided_by") @db.Uuid
  voidReason       String?    @map("void_reason")
  voidAuthorizedBy String?    @map("void_authorized_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  session  CashSession   @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments SalePayment[]

  @@unique([storeId, number])
  @@unique([tenantId, clientOpId])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([cashSessionId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  qty            Decimal @db.Decimal(12, 3)
  unitPrice      BigInt  @map("unit_price") // congelado al vender
  unitCostAtSale BigInt  @default(0) @map("unit_cost_at_sale") // CPP congelado
  discount       BigInt  @default(0)
  lineTotal      BigInt  @map("line_total")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  method         PaymentMethod
  amount         BigInt
  amountTendered BigInt?       @map("amount_tendered") // efectivo recibido (cambio)
  reference      String? // nº voucher / transferencia

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}

// ──────────────── Proveedores, compras y gastos (Fase 3) ────────────────

model Supplier {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  taxId       String?   @map("tax_id") // NIT
  contactName String?   @map("contact_name")
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  purchases    Purchase[]
  productLinks ProductSupplier[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

// Relación producto↔proveedor: último costo para agilizar la recepción.
model ProductSupplier {
  tenantId       String    @map("tenant_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  supplierSku    String?   @map("supplier_sku")
  lastCost       BigInt?   @map("last_cost")
  lastPurchaseAt DateTime? @map("last_purchase_at") @db.Timestamptz()

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

enum PurchaseStatus {
  RECEIVED
  VOIDED
}

// Las compras no se borran; solo transición RECEIVED→VOIDED (trigger).
model Purchase {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  storeId         String         @map("store_id") @db.Uuid
  supplierId      String         @map("supplier_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  status          PurchaseStatus @default(RECEIVED)
  supplierInvoice String?        @map("supplier_invoice")
  purchasedAt     DateTime       @default(now()) @map("purchased_at") @db.Timestamptz()
  total           BigInt
  notes           String?
  voidedAt        DateTime?      @map("voided_at") @db.Timestamptz()
  voidedBy        String?        @map("voided_by") @db.Uuid
  voidReason      String?        @map("void_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([storeId, purchasedAt(sort: Desc)])
  @@index([supplierId, purchasedAt(sort: Desc)])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  qty        Decimal @db.Decimal(12, 3)
  unitCost   BigInt  @map("unit_cost")
  lineTotal  BigInt  @map("line_total")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model ExpenseCategory {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

// Gastos: sin DELETE (trigger); monto inmutable, solo categoría/descripción
// editables (validado en dominio y auditado).
model Expense {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  cashSessionId String?  @map("cash_session_id") @db.Uuid // si salió de caja
  userId        String   @map("user_id") @db.Uuid
  amount        BigInt
  description   String
  evidenceUrl   String?  @map("evidence_url")
  expensedAt    DateTime @default(now()) @map("expensed_at") @db.Timestamptz()
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([storeId, expensedAt(sort: Desc)])
  @@map("expenses")
}

// ──────────────── Alertas, notificaciones y agregados (Fase 4) ────────────────

enum AlertStatus {
  ACTIVE
  RESOLVED
}

// Episodios de stock bajo: una sola alerta ACTIVE por store_product (índice
// parcial en la migración); se resuelve sola al recuperarse el stock.
model StockAlert {
  id             String      @id @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  storeProductId String      @map("store_product_id") @db.Uuid
  status         AlertStatus @default(ACTIVE)
  triggeredAt    DateTime    @default(now()) @map("triggered_at") @db.Timestamptz()
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz()

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("stock_alerts")
}

model Notification {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String // 'STOCK_LOW', 'CASH_DIFFERENCE', ...
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Agregados diarios por tienda (dashboard instantáneo). Se refrescan de forma
// idempotente al consultar el rango — no requiere scheduler (D-020).
model DailyStoreStat {
  tenantId       String   @map("tenant_id") @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  day            DateTime @db.Date
  salesCount     Int      @default(0) @map("sales_count")
  salesTotal     BigInt   @default(0) @map("sales_total")
  costTotal      BigInt   @default(0) @map("cost_total")
  profitTotal    BigInt   @default(0) @map("profit_total")
  voidedCount    Int      @default(0) @map("voided_count")
  expensesTotal  BigInt   @default(0) @map("expenses_total")
  purchasesTotal BigInt   @default(0) @map("purchases_total")

  @@id([storeId, day])
  @@index([tenantId, day])
  @@map("daily_store_stats")
}

// ─────────────────────────── Auditoría ───────────────────────────

model AuditLog {
  id             String   @id @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  impersonating  Boolean  @default(false)
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
